--[[
	PropsBatch4Facets (dev tool data) - Agent A facet pieces for the hub / plains batch 4 (guide D6), converted from
	Blender_Exports/Props/facets/<piece>.json by Agent B. Compact form: per piece a palette { "hex" | "hex|Neon" } and
	a base64 blob of faces, each = palette index (u8), corner count (u8, 3 or 4), thickness t in 1/1000 stud (u16 LE),
	then per corner x, y, z in 1/500 stud (i16 LE, the cone roof reaches y 54). On require each piece is decoded into the
	usual { palette, tris } (tris { x1, y1, z1, x2, y2, z2, x3, y3, z3, t, index }, moved t/2 inward along the face
	normal; a quad is split on the diagonal whose 2 halves agree with the face normal, slivers are dropped), as in the
	earlier data modules. Origins (guide D6): torch_flame = the flame base, torch_cup = the rim centre, banner_cloth = the
	Banner_A pivot, flag_cloth = the pole axis at the flag bottom, tower_cone_roof = the Hub_Tower pivot,
	guide_open_book = the spine centre, mace_spike = the centre of a Spike box. Source of truth:
	tools/PropsBatch4Facets.luau.
]]
local EncodingService = game:GetService("EncodingService")

local Data = {}

local function sub(a: Vector3, b: Vector3): Vector3
	return a - b
end

-- the faces of a blob as { palette, tris }
local function decode(palette: { string }, b64: string): any
	local raw = EncodingService:Base64Decode(buffer.fromstring((string.gsub(b64, "%s", ""))))
	local tris = {}
	local at = 0
	local size = buffer.len(raw)
	while at < size do
		local pal = buffer.readu8(raw, at)
		local n = buffer.readu8(raw, at + 1)
		local t = buffer.readu16(raw, at + 2) / 1000
		at += 4
		local v = {}
		for k = 1, n do
			v[k] = Vector3.new(buffer.readi16(raw, at), buffer.readi16(raw, at + 2), buffer.readi16(raw, at + 4)) / 500
			at += 6
		end
		-- the face normal (Newell, over all corners)
		local N = Vector3.zero
		for i = 1, n do
			local p, q = v[i], v[i % n + 1]
			N += Vector3.new((p.Y - q.Y) * (p.Z + q.Z), (p.Z - q.Z) * (p.X + q.X), (p.X - q.X) * (p.Y + q.Y))
		end
		if N.Magnitude > 1e-9 then
			N = N.Unit
			local polys
			if n == 3 then
				polys = { { v[1], v[2], v[3] } }
			else
				polys = { { v[1], v[2], v[3] }, { v[1], v[3], v[4] } }
				for _, tri in ipairs(polys) do
					if sub(tri[2], tri[1]):Cross(sub(tri[3], tri[1])):Dot(N) < 0 then
						polys = { { v[2], v[3], v[4] }, { v[2], v[4], v[1] } }
						break
					end
				end
			end
			for _, tri in ipairs(polys) do
				local a, b, c = tri[1], tri[2], tri[3]
				local cr = sub(b, a):Cross(sub(c, a))
				local L = math.max((a - b).Magnitude, (b - c).Magnitude, (a - c).Magnitude)
				if cr.Magnitude >= 1e-6 and cr.Magnitude / L >= 0.01 and cr:Dot(N) > 0 then
					local o = N * (t / 2)
					local wa, wb, wc = a - o, b - o, c - o
					table.insert(tris, { wa.X, wa.Y, wa.Z, wb.X, wb.Y, wb.Z, wc.X, wc.Y, wc.Z, t, pal })
				end
			end
		end
	end
	return { palette = palette, tris = tris }
end

