	for _, t in ipairs(Data[kit]) do
		table.insert(out, { name = t[1], class = t[2], shape = t[3], size = Vector3.new(t[4], t[5], t[6]), cf = CFrame.new(t[7], t[8], t[9], t[10], t[11], t[12], t[13], t[14], t[15], t[16], t[17], t[18]), color = Color3.fromHex(t[19]), collide = t[20], transparency = t[21], material = t[22], parent = t[23], query = t[24], meshId = t[25], fidelity = t[26] })
	end
	return out
end

