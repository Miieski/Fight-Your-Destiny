-- a part row with its CFrame and colour built
function Data.row(t: any): any
	return {
		name = t.n, class = t.c, shape = t.sh, size = Vector3.new(t.s[1], t.s[2], t.s[3]),
		cf = CFrame.new(table.unpack(t.cf)), color = Color3.fromHex(t.col), collide = t.cc, transparency = t.t,
		material = t.m, query = t.q, parent = t.p, meshId = t.mesh, attrs = t.a, light = t.light,
	}
end

-- the part rows of a landmark (all, or those named `name`)
function Data.rows(id: string, name: string?): { any }
	local out = {}
	for _, t in ipairs(Data[id].parts) do
		if name == nil or t.n == name then
			table.insert(out, Data.row(t))
		end
	end
	return out
end

return Data
