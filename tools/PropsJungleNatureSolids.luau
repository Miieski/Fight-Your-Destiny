--[[
	PropsJungleNatureSolids (dev tool data) - Agent A's rock and moss facet pieces (jungle PROMPT_06: rock_s / m / l
	body + moss, waterfall rocks) rebuilt as convex solids, converted by Agent B: each connected shell of a piece becomes
	the intersection of its face planes (each pushed out to touch the shell, so a slightly concave moss mound becomes its
	hull) and a closing plane over its open rim; every plane keeps its face colour. Built with GeometryService a solid of
	20 planes costs about 40-60 triangles, against about 30 per face for the same faces as wedge pairs (the rocks would
	pass their triangle budgets). Pieces of 1-2 faces (grass blades, cracks) stay faces ({ palette, tris } as in
	PropsJungleNatureData). Compact form: per piece a palette and a base64 blob: per solid the plane count (u8), the
	box min / max (6 x i16, 1/1000 stud), then per plane nx, ny, nz (3 x i16, 1/30000), d (i32, 1/1000 stud) and the
	palette index (u8); then the loose faces as in PropsJungleNatureData. Origins: the kit pivots. Source of truth:
	tools/PropsJungleNatureSolids.luau.
]]
local EncodingService = game:GetService("EncodingService")

local Data = {}

-- { solids = { { lo, hi, planes = { { nx, ny, nz, d, "#hex" } } } }, faces = { palette, tris } }
local function decode(palette: { string }, b64: string): any
	local raw = EncodingService:Base64Decode(buffer.fromstring((string.gsub(b64, "%s", ""))))
	local at = 0
	local nSolids = buffer.readu16(raw, at)
	at += 2
	local solids = {}
	for _ = 1, nSolids do
		local n = buffer.readu8(raw, at)
		at += 1
		local b = {}
		for k = 1, 6 do
			b[k] = buffer.readi16(raw, at) / 1000
			at += 2
		end
		local planes = {}
		for _ = 1, n do
			local nx, ny, nz = buffer.readi16(raw, at) / 30000, buffer.readi16(raw, at + 2) / 30000, buffer.readi16(raw, at + 4) / 30000
			local d = buffer.readi32(raw, at + 6) / 1000
			local c = buffer.readu8(raw, at + 10)
			at += 11
			table.insert(planes, { nx, ny, nz, d, palette[c] })
		end
		table.insert(solids, { lo = Vector3.new(b[1], b[2], b[3]), hi = Vector3.new(b[4], b[5], b[6]), planes = planes })
	end
	-- the loose faces: palette index (u8), corner count (u8), t (u16, 1/1000), corners (3 x i16, 1/1000)
	local tris = {}
	local size = buffer.len(raw)
	while at < size do
		local pal = buffer.readu8(raw, at)
		local n = buffer.readu8(raw, at + 1)
		local t = buffer.readu16(raw, at + 2) / 1000
		at += 4
		local v = {}
		for k = 1, n do
			v[k] = Vector3.new(buffer.readi16(raw, at), buffer.readi16(raw, at + 2), buffer.readi16(raw, at + 4)) / 1000
			at += 6
		end
		local N = Vector3.zero
		for i = 1, n do
			local p, q = v[i], v[i % n + 1]
			N += Vector3.new((p.Y - q.Y) * (p.Z + q.Z), (p.Z - q.Z) * (p.X + q.X), (p.X - q.X) * (p.Y + q.Y))
		end
		if N.Magnitude > 1e-9 then
			N = N.Unit
			local o = N * (t / 2)
			for k = 2, n - 1 do
				local a, b, c = v[1] - o, v[k] - o, v[k + 1] - o
				if (b - a):Cross(c - a).Magnitude > 1e-6 then
					table.insert(tris, { a.X, a.Y, a.Z, b.X, b.Y, b.Z, c.X, c.Y, c.Z, t, pal })
				end
			end
		end
	end
	return { solids = solids, faces = { palette = palette, tris = tris } }
end

