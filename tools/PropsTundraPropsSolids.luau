--[[
	PropsTundraPropsSolids (dev tool data) - Agent A's tundra props facet pieces (Blender_Exports/Props/facets/
	tundra_props__*.json; guide E10) rebuilt as convex solids by Agent B, exactly as PropsTundraBuildingsSolids: every
	piece is made of closed convex shells, each shell becomes the intersection of its face planes (coplanar faces merged;
	each plane keeps its face colour; a face that would cut its own shell is left out). Compact form: per piece a palette
	and a base64 blob: the solid count (u16), then per solid the plane count (u8), a Glass flag (u8), the box min / max
	(6 x i16, 1/1000 stud), then per plane nx, ny, nz (3 x i16, 1/30000), d (i32, 1/1000 stud) and the palette index
	(u8). Origins and placements: each piece's `place` in its JSON (guide E10). Source of truth:
	tools/PropsTundraPropsSolids.luau; regenerate with python tools/tundra_facets_to_solids.py <project root> props.
]]
local EncodingService = game:GetService("EncodingService")

local Data = {}

-- { solids = { { lo, hi, glass, planes = { { nx, ny, nz, d, "#hex" } } } } }
local function decode(palette: { string }, b64: string): any
	local raw = EncodingService:Base64Decode(buffer.fromstring((string.gsub(b64, "%s", ""))))
	local at = 0
	local n = buffer.readu16(raw, at)
	at += 2
	local solids = {}
	for _ = 1, n do
		local count, glass = buffer.readu8(raw, at), buffer.readu8(raw, at + 1)
		at += 2
		local b = {}
		for k = 1, 6 do
			b[k] = buffer.readi16(raw, at) / 1000
			at += 2
		end
		local planes = {}
		for _ = 1, count do
			local nx, ny, nz = buffer.readi16(raw, at) / 30000, buffer.readi16(raw, at + 2) / 30000, buffer.readi16(raw, at + 4) / 30000
			local d = buffer.readi32(raw, at + 6) / 1000
			local c = buffer.readu8(raw, at + 10)
			at += 11
			table.insert(planes, { nx, ny, nz, d, palette[c] })
		end
		table.insert(solids, { lo = Vector3.new(b[1], b[2], b[3]), hi = Vector3.new(b[4], b[5], b[6]), glass = glass == 1, planes = planes })
	end
	return { solids = solids }
end

